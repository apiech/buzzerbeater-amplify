{
  "name": "aws-amplify-gen2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:3003": "next dev -p 3003",
    "build": "next build",
    "analyze:bundle": "ANALYZE=true next build --webpack",
    "analyze:artifacts": "node --import tsx ./scripts/analyze-react-bloat.ts",
    "analyze:all": "npm run analyze:bundle && npm run analyze:artifacts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "next start",
    "lint": "eslint app amplify tests scripts lib infra next.config.js eslint.config.mjs",
    "test": "node --test --import tsx ./tests/*.test.ts",
    "test:bbapi": "node --test --import tsx ./tests/bbapi-parser.test.ts",
    "generate:bbapi-goldens": "node --import tsx ./scripts/generate-bbapi-goldens.ts",
    "billing:override": "node --import tsx ./scripts/set-billing-override.ts",
    "cdk:match-data-plane:synth": "cdk synth --app 'tsx infra/match-data-plane/bin/match-data-plane.ts'",
    "cdk:match-data-plane:deploy": "cdk deploy --app 'tsx infra/match-data-plane/bin/match-data-plane.ts'",
    "cdk:matchup-predictor:synth:dev": "cdk synth --app 'tsx infra/matchup-predictor/bin/matchup-predictor.ts' --context stage=dev",
    "cdk:matchup-predictor:deploy:dev": "cdk deploy --app 'tsx infra/matchup-predictor/bin/matchup-predictor.ts' --context stage=dev",
    "cdk:matchup-predictor:synth:prod": "cdk synth --app 'tsx infra/matchup-predictor/bin/matchup-predictor.ts' --context stage=prod",
    "cdk:matchup-predictor:deploy:prod": "cdk deploy --app 'tsx infra/matchup-predictor/bin/matchup-predictor.ts' --context stage=prod"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1009.0",
    "@aws-sdk/client-dynamodb": "^3.1009.0",
    "@aws-sdk/client-s3": "^3.1009.0",
    "@aws-sdk/client-sagemaker-runtime": "^3.1009.0",
    "@aws-sdk/client-secrets-manager": "^3.1009.0",
    "@aws-sdk/client-sqs": "^3.1009.0",
    "@aws-sdk/lib-dynamodb": "^3.1009.0",
    "aws-amplify": "^6.16.3",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.5.5",
    "next": "16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@aws-amplify/backend": "1.21.1",
    "@aws-amplify/backend-cli": "1.8.2",
    "@next/bundle-analyzer": "^16.1.6",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/context-async-hooks": "2.5.0",
    "@opentelemetry/core": "2.5.0",
    "@opentelemetry/sdk-trace-base": "2.5.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "aws-cdk": "^2.1111.0",
    "aws-cdk-lib": "^2",
    "constructs": "^10.3.0",
    "esbuild": "^0.27.4",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.1.6",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  }
}
