{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "amplify/**/*.ts",
    "lib/**/*.ts",
    "infra/**/*.ts",
    "proxy.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".amplify",
    ".next",
    "cdk.out",
    "out",
    "build"
  ]
}
